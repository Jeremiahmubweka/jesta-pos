
import { useEffect, useState } from "react";
import {
  Building2, Users, ShieldCheck, Settings as SettingsIcon,
  Palette, Save, Lock, Mail, Phone, MapPin, Globe,
  CheckCircle2, AlertCircle, Loader2, X, RefreshCw,
  Check, UserPlus, UserX, UserCheck, CreditCard,
} from "lucide-react";

import { supabase } from "../lib/supabase";
import { useTheme } from "../theme/ThemeProvider";
import {
  getOfflineMetadata,
  saveOfflineMetadata,
} from "../lib/offline/database";

const isNetworkError = (error) => {
  const message = String(
    error?.message || error?.details || error || ""
  ).toLowerCase();

  return (
    !navigator.onLine ||
    message.includes("failed to fetch") ||
    message.includes("network") ||
    message.includes("internet") ||
    message.includes("err_internet_disconnected") ||
    message.includes("load failed") ||
    message.includes("fetch")
  );
};

function Settings() {
  const [activeSection, setActiveSection] = useState("Business");

  const [businessId, setBusinessId] = useState(null);
  const [business, setBusiness] = useState(null);
  const [loadingBusiness, setLoadingBusiness] = useState(true);
  const [savingBusiness, setSavingBusiness] = useState(false);

  const [message, setMessage] = useState("");
  const [errorMessage, setErrorMessage] = useState("");

  const [businessForm, setBusinessForm] = useState({
    name: "",
    business_type: "",
    phone: "",
    email: "",
    address: "",
    tax_number: "",
    currency: "KES",
    timezone: "Africa/Nairobi",
  });

  const [mpesaForm, setMpesaForm] = useState({
    enabled: false,
    merchant_type: "paybill",
    merchant_number: "",
    environment: "sandbox",
  });

  const [savingMpesa, setSavingMpesa] = useState(false);
  const [currentUser, setCurrentUser] = useState(null);

  const [employees, setEmployees] = useState([]);
  const [loadingEmployees, setLoadingEmployees] = useState(false);
  const [employeeModalOpen, setEmployeeModalOpen] = useState(false);
  const [savingEmployee, setSavingEmployee] = useState(false);
  const [employeeActionId, setEmployeeActionId] = useState(null);

  const [employeeForm, setEmployeeForm] = useState({
    full_name: "",
    email: "",
    phone: "",
    password: "",
  });

  const [passwordForm, setPasswordForm] = useState({
    newPassword: "",
    confirmPassword: "",
  });

  const [updatingPassword, setUpdatingPassword] = useState(false);

  const {
    themeId,
    themes,
    changeTheme,
    loadingTheme,
  } = useTheme();

  const [changingTheme, setChangingTheme] = useState(false);

  const settingsSections = [
    {
      name: "Business",
      icon: Building2,
      description: "Manage your business information",
    },
    {
      name: "Payments",
      icon: CreditCard,
      description: "Configure M-Pesa payments",
    },
    {
      name: "Users",
      icon: Users,
      description: "Manage employees and access",
    },
    {
      name: "Security",
      icon: ShieldCheck,
      description: "Manage your account security",
    },
    {
      name: "Appearance",
      icon: Palette,
      description: "Customize your JESTA POS theme",
    },
    {
      name: "System",
      icon: SettingsIcon,
      description: "View system configuration",
    },
  ];


  const clearMessages = () => {
    setMessage("");
    setErrorMessage("");
  };

  /*
   * Retrieve the locally stored Supabase session.
   * Unlike getUser(), getSession() does not normally
   * require a request to /auth/v1/user.
   */
  const loadCurrentUser = async () => {
    try {
      const { data, error } = await supabase.auth.getSession();

      if (error) throw error;

      setCurrentUser(data?.session?.user || null);
    } catch (error) {
      console.error("Current user loading error:", error);
      setCurrentUser(null);
    }
  };

  /*
   * Apply business data to the Settings interface.
   */
  const applyBusinessData = (data) => {
    if (!data) return;

    setBusiness(data);
    setBusinessId(data.id);

    setBusinessForm({
      name: data.name || "",
      business_type: data.business_type || "",
      phone: data.phone || "",
      email: data.email || "",
      address: data.address || "",
      tax_number: data.tax_number || "",
      currency: data.currency || "KES",
      timezone: data.timezone || "Africa/Nairobi",
    });

    setMpesaForm({
      enabled: data.mpesa_enabled ?? false,
      merchant_type: data.mpesa_merchant_type || "paybill",
      merchant_number: data.mpesa_merchant_number || "",
      environment: data.mpesa_environment || "sandbox",
    });
  };

  /*
   * Load business information.
   *
   * Online:
   *   Fetch business information from Supabase
   *   and save a local copy in IndexedDB.
   *
   * Offline:
   *   Load the previously cached business information.
   */
  const loadBusiness = async () => {
    setLoadingBusiness(true);
    clearMessages();

    let cacheKey = null;

    try {
      const { data: sessionData, error: sessionError } =
        await supabase.auth.getSession();

      if (sessionError) throw sessionError;

      const user = sessionData?.session?.user;

      if (!user?.id) {
        setErrorMessage(
          "Your login session could not be found. Please sign in again."
        );
        return;
      }

      cacheKey = `jesta_business_${user.id}`;

      if (!navigator.onLine) {
        const cachedBusiness = await getOfflineMetadata(cacheKey);

        if (cachedBusiness) {
          applyBusinessData(cachedBusiness);
          setMessage(
            "Business information loaded from this device. You are offline."
          );
        } else {
          setErrorMessage(
            "No saved business information is available offline. Connect to the internet and open Settings once."
          );
        }

        return;
      }

      const {
        data: businessIdData,
        error: businessIdError,
      } = await supabase.rpc("get_my_business_id");

      if (businessIdError) throw businessIdError;

      const resolvedBusinessId = Number(businessIdData);

      if (!resolvedBusinessId) {
        setErrorMessage(
          "No business is associated with your account."
        );
        return;
      }

      const { data, error } = await supabase
        .from("businesses")
        .select("*")
        .eq("id", resolvedBusinessId)
        .single();

      if (error) throw error;

      if (!data) {
        setErrorMessage(
          "Business information could not be found."
        );
        return;
      }

      applyBusinessData(data);

      /*
       * Cache separately. A cache failure must not
       * prevent successfully loaded online data
       * from appearing in Settings.
       */
      try {
        await saveOfflineMetadata(cacheKey, data);
      } catch (cacheError) {
        console.error(
          "Business cache saving error:",
          cacheError
        );
      }
    } catch (error) {
      console.error("Business loading error:", error);

      if (isNetworkError(error) && cacheKey) {
        try {
          const cachedBusiness =
            await getOfflineMetadata(cacheKey);

          if (cachedBusiness) {
            applyBusinessData(cachedBusiness);
            setMessage(
              "Showing saved business information. The server is currently unavailable."
            );
          } else {
            setErrorMessage(
              "You are offline and no saved business information is available."
            );
          }
        } catch (cacheError) {
          console.error(
            "Business cache retrieval error:",
            cacheError
          );

          setErrorMessage(
            "Unable to load business information from this device."
          );
        }
      } else {
        setErrorMessage(
          error?.message ||
            "Something went wrong while loading business information."
        );
      }
    } finally {
      setLoadingBusiness(false);
    }
  };

  /*
   * M-Pesa settings
   */
  const handleMpesaChange = (event) => {
    const { name, value, type, checked } = event.target;

    setMpesaForm((previous) => ({
      ...previous,
      [name]: type === "checkbox" ? checked : value,
    }));

    clearMessages();
  };

  const handleSaveMpesa = async (event) => {
    event.preventDefault();
    clearMessages();

    if (!navigator.onLine) {
      setErrorMessage(
        "You need an internet connection to save M-Pesa settings."
      );
      return;
    }

    if (!businessId) {
      setErrorMessage(
        "Business information is not available. Please refresh the page."
      );
      return;
    }

    if (
      mpesaForm.enabled &&
      !mpesaForm.merchant_number.trim()
    ) {
      setErrorMessage(
        `Please enter your ${
          mpesaForm.merchant_type === "till"
            ? "Till Number"
            : "PayBill Number"
        }.`
      );
      return;
    }

    setSavingMpesa(true);

    try {
      const { error } = await supabase
        .from("businesses")
        .update({
          mpesa_enabled: mpesaForm.enabled,
          mpesa_merchant_type: mpesaForm.merchant_type,
          mpesa_merchant_number:
            mpesaForm.merchant_number.trim() || null,
          mpesa_environment: mpesaForm.environment,
          updated_at: new Date().toISOString(),
        })
        .eq("id", businessId);

      if (error) throw error;

      const updatedBusiness = {
        ...(business || {}),
        mpesa_enabled: mpesaForm.enabled,
        mpesa_merchant_type: mpesaForm.merchant_type,
        mpesa_merchant_number:
          mpesaForm.merchant_number.trim() || null,
        mpesa_environment: mpesaForm.environment,
      };

      setBusiness(updatedBusiness);

      if (currentUser?.id) {
        try {
          await saveOfflineMetadata(
            `jesta_business_${currentUser.id}`,
            updatedBusiness
          );
        } catch (cacheError) {
          console.error("Business cache update error:", cacheError);
        }
      }

      setMessage(
        "M-Pesa payment settings updated successfully."
      );
    } catch (error) {
      console.error("M-Pesa settings update error:", error);
      setErrorMessage(
        error.message ||
          "Something went wrong while saving your M-Pesa settings."
      );
    } finally {
      setSavingMpesa(false);
    }
  };

  /*
   * Employee loading with IndexedDB caching.
   */
  const loadEmployees = async () => {
    setLoadingEmployees(true);

    let cacheKey = null;

    try {
      const { data: sessionData, error: sessionError } =
        await supabase.auth.getSession();

      if (sessionError) throw sessionError;

      const user = sessionData?.session?.user;

      if (!user?.id) {
        setEmployees([]);
        return;
      }

      cacheKey = `jesta_employees_${user.id}`;

      if (!navigator.onLine) {
        const cachedEmployees =
          await getOfflineMetadata(cacheKey);

        if (Array.isArray(cachedEmployees)) {
          setEmployees(cachedEmployees);
        } else {
          setEmployees([]);
          setErrorMessage(
            "No saved employee list is available offline. Connect to the internet and open Settings once."
          );
        }

        return;
      }

      const { data, error } =
        await supabase.functions.invoke(
          "manage-employees",
          {
            body: {
              action: "list",
            },
          }
        );

      if (error) throw error;

      if (data?.error) {
        setErrorMessage(data.error);
        return;
      }

      const employeeList = Array.isArray(data?.employees)
        ? data.employees
        : [];

      setEmployees(employeeList);

      try {
        await saveOfflineMetadata(
          cacheKey,
          employeeList
        );
      } catch (cacheError) {
        console.error(
          "Employee cache saving error:",
          cacheError
        );
      }
    } catch (error) {
      console.error("Employee loading error:", error);

      if (isNetworkError(error) && cacheKey) {
        try {
          const cachedEmployees =
            await getOfflineMetadata(cacheKey);

          if (Array.isArray(cachedEmployees)) {
            setEmployees(cachedEmployees);
            setMessage(
              "Showing the saved employee list. The server is currently unavailable."
            );
          } else {
            setEmployees([]);
            setErrorMessage(
              "You are offline and no saved employee list is available."
            );
          }
        } catch (cacheError) {
          console.error(
            "Employee cache retrieval error:",
            cacheError
          );

          setEmployees([]);
          setErrorMessage(
            "Unable to load the saved employee list."
          );
        }
      } else {
        setErrorMessage(
          error.message ||
            "Unable to load employees."
        );
      }
    } finally {
      setLoadingEmployees(false);
    }
  };

  useEffect(() => {
    const timer = setTimeout(() => {
      loadCurrentUser();
      loadBusiness();
      loadEmployees();
    }, 0);

    return () => clearTimeout(timer);
  }, []);

  const handleEmployeeFormChange = (event) => {
    const { name, value } = event.target;

    setEmployeeForm((previous) => ({
      ...previous,
      [name]: value,
    }));

    clearMessages();
  };

  const resetEmployeeForm = () => {
    setEmployeeForm({
      full_name: "",
      email: "",
      phone: "",
      password: "",
    });
  };

  const handleOpenEmployeeModal = () => {
    clearMessages();
    resetEmployeeForm();
    setEmployeeModalOpen(true);
  };

  const handleCloseEmployeeModal = () => {
    if (savingEmployee) return;

    setEmployeeModalOpen(false);
    resetEmployeeForm();
  };

  const handleCreateEmployee = async (event) => {
    event.preventDefault();
    clearMessages();

    if (!navigator.onLine) {
      setErrorMessage(
        "An internet connection is required to create an employee account."
      );
      return;
    }

    const { full_name, email, phone, password } =
      employeeForm;

    if (!full_name.trim()) {
      setErrorMessage("Employee full name is required.");
      return;
    }

    if (!email.trim()) {
      setErrorMessage("Employee email is required.");
      return;
    }

    if (password.length < 8) {
      setErrorMessage(
        "Employee password must be at least 8 characters long."
      );
      return;
    }

    setSavingEmployee(true);

    try {
      const { data, error } =
        await supabase.functions.invoke(
          "manage-employees",
          {
            body: {
              action: "create",
              full_name: full_name.trim(),
              email: email.trim().toLowerCase(),
              phone: phone.trim() || null,
              password,
            },
          }
        );

      if (error) throw error;

      if (data?.error) {
        setErrorMessage(data.error);
        return;
      }

      setEmployeeModalOpen(false);
      resetEmployeeForm();

      await loadEmployees();

      setMessage(
        "Employee account created successfully."
      );
    } catch (error) {
      console.error("Employee creation error:", error);
      setErrorMessage(
        error.message ||
          "Something went wrong while creating the employee account."
      );
    } finally {
      setSavingEmployee(false);
    }
  };

  const handleEmployeeStatusToggle = async (employee) => {
    clearMessages();

    if (!navigator.onLine) {
      setErrorMessage(
        "An internet connection is required to change employee access."
      );
      return;
    }

    const isCurrentlyActive = employee.is_active;
    const action = isCurrentlyActive ? "deactivate" : "reactivate";

    const confirmationMessage = isCurrentlyActive
      ? `Deactivate ${employee.full_name}? They will no longer be able to access this JESTA POS business.`
      : `Reactivate ${employee.full_name}? They will regain access to this JESTA POS business.`;

    if (!window.confirm(confirmationMessage)) return;

    setEmployeeActionId(employee.id);

    try {
      const { data, error } =
        await supabase.functions.invoke(
          "manage-employees",
          {
            body: {
              action,
              user_id: employee.id,
            },
          }
        );

      if (error) throw error;

      if (data?.error) {
        setErrorMessage(data.error);
        return;
      }

      await loadEmployees();

      setMessage(
        isCurrentlyActive
          ? "Employee account deactivated successfully."
          : "Employee account reactivated successfully."
      );
    } catch (error) {
      console.error("Employee status update error:", error);
      setErrorMessage(
        error.message ||
          `Something went wrong while trying to ${action} the employee.`
      );
    } finally {
      setEmployeeActionId(null);
    }
  };

  const handleBusinessChange = (event) => {
    const { name, value } = event.target;

    setBusinessForm((previous) => ({
      ...previous,
      [name]: value,
    }));

    clearMessages();
  };

  const handleSaveBusiness = async (event) => {
    event.preventDefault();
    clearMessages();

    if (!navigator.onLine) {
      setErrorMessage(
        "An internet connection is required to save business information."
      );
      return;
    }

    if (!businessId) {
      setErrorMessage(
        "Business information is not available. Please refresh the page."
      );
      return;
    }

    if (!businessForm.name.trim()) {
      setErrorMessage("Business name is required.");
      return;
    }

    setSavingBusiness(true);

    try {
      const updatedFields = {
        name: businessForm.name.trim(),
        business_type:
          businessForm.business_type.trim() || null,
        phone: businessForm.phone.trim() || null,
        email: businessForm.email.trim() || null,
        address: businessForm.address.trim() || null,
        tax_number: businessForm.tax_number.trim() || null,
        currency: businessForm.currency.trim() || "KES",
        timezone:
          businessForm.timezone.trim() || "Africa/Nairobi",
        updated_at: new Date().toISOString(),
      };

      const { error } = await supabase
        .from("businesses")
        .update(updatedFields)
        .eq("id", businessId);

      if (error) throw error;

      const updatedBusiness = {
        ...(business || {}),
        ...updatedFields,
      };

      setBusiness(updatedBusiness);

      if (currentUser?.id) {
        try {
          await saveOfflineMetadata(
            `jesta_business_${currentUser.id}`,
            updatedBusiness
          );
        } catch (cacheError) {
          console.error("Business cache update error:", cacheError);
        }
      }

      setMessage(
        "Business information updated successfully."
      );
    } catch (error) {
      console.error("Business update error:", error);
      setErrorMessage(
        error.message ||
          "Something went wrong while saving your business information."
      );
    } finally {
      setSavingBusiness(false);
    }
  };

  /*
   * Theme change
   */
  const handleThemeChange = async (selectedThemeId) => {
    if (
      selectedThemeId === themeId ||
      changingTheme
    ) {
      return;
    }

    if (!navigator.onLine) {
      setErrorMessage(
        "An internet connection is required to save a business-wide theme."
      );
      return;
    }

    clearMessages();
    setChangingTheme(true);

    try {
      const result = await changeTheme(selectedThemeId);

      if (result.success) {
        setMessage(
          "JESTA POS theme updated successfully."
        );
      } else {
        setErrorMessage(
          result.error ||
            "Unable to update the JESTA POS theme."
        );
      }
    } catch (error) {
      console.error("Theme update error:", error);
      setErrorMessage(
        error.message ||
          "Something went wrong while changing the theme."
      );
    } finally {
      setChangingTheme(false);
    }
  };

  const handlePasswordChange = (event) => {
    const { name, value } = event.target;

    setPasswordForm((previous) => ({
      ...previous,
      [name]: value,
    }));

    clearMessages();
  };

  const handlePasswordUpdate = async (event) => {
    event.preventDefault();
    clearMessages();

    if (!navigator.onLine) {
      setErrorMessage(
        "An internet connection is required to update your password."
      );
      return;
    }

    const { newPassword, confirmPassword } = passwordForm;

    if (!newPassword) {
      setErrorMessage("Please enter a new password.");
      return;
    }

    if (newPassword.length < 6) {
      setErrorMessage(
        "Password must be at least 6 characters long."
      );
      return;
    }

    if (newPassword !== confirmPassword) {
      setErrorMessage(
        "The new password and confirmation password do not match."
      );
      return;
    }

    setUpdatingPassword(true);

    try {
      const { error } = await supabase.auth.updateUser({
        password: newPassword,
      });

      if (error) throw error;

      setPasswordForm({
        newPassword: "",
        confirmPassword: "",
      });

      setMessage(
        "Your password has been updated successfully."
      );
    } catch (error) {
      console.error("Password update error:", error);
      setErrorMessage(
        error.message ||
          "Something went wrong while updating your password."
      );
    } finally {
      setUpdatingPassword(false);
    }
  };

  const handleCloseMessage = () => clearMessages();

  const renderBusinessSection = () => {
    if (loadingBusiness) {
      return (
        <div className="jesta-settings-loading">
          <Loader2 size={24} className="jesta-settings-loading-icon" />
          <p>Loading business information...</p>
        </div>
      );
    }

    return (
      <div className="jesta-settings-panel">
        <div className="jesta-settings-panel-header">
          <div className="jesta-settings-panel-heading">
            <div className="jesta-settings-panel-icon">
              <Building2 size={20} />
            </div>
            <div>
              <h2>Business Information</h2>
              <p>
                Manage the information used throughout your JESTA POS system.
              </p>
            </div>
          </div>

          <button
            type="button"
            className="jesta-settings-close"
            onClick={loadBusiness}
            title="Refresh business information"
            aria-label="Refresh business information"
          >
            <RefreshCw size={17} />
          </button>
        </div>

        <form onSubmit={handleSaveBusiness} className="jesta-settings-form">
          <div className="jesta-settings-form-grid">
            {[
              {
                id: "business-name",
                label: "Business Name",
                name: "name",
                icon: Building2,
                placeholder: "Enter business name",
                required: true,
              },
              {
                id: "business-type",
                label: "Business Type",
                name: "business_type",
                icon: SettingsIcon,
                placeholder: "e.g. General Retail",
              },
              {
                id: "business-phone",
                label: "Phone Number",
                name: "phone",
                icon: Phone,
                placeholder: "e.g. 0700000000",
              },
              {
                id: "business-email",
                label: "Business Email",
                name: "email",
                icon: Mail,
                placeholder: "business@example.com",
                type: "email",
              },
              {
                id: "business-address",
                label: "Business Address",
                name: "address",
                icon: MapPin,
                placeholder: "Enter business address",
                full: true,
              },
              {
                id: "business-tax",
                label: "Tax Number",
                name: "tax_number",
                icon: ShieldCheck,
                placeholder: "Optional",
              },
              {
                id: "business-currency",
                label: "Currency",
                name: "currency",
                icon: Globe,
                placeholder: "KES",
              },
              {
                id: "business-timezone",
                label: "Timezone",
                name: "timezone",
                icon: Globe,
                placeholder: "Africa/Nairobi",
              },
            ].map((field) => {
              const Icon = field.icon;

              return (
                <div
                  key={field.name}
                  className={`jesta-settings-field ${
                    field.full ? "jesta-settings-field-full" : ""
                  }`}
                >
                  <label htmlFor={field.id}>{field.label}</label>
                  <div className="jesta-settings-input-wrap">
                    <Icon size={17} />
                    <input
                      id={field.id}
                      name={field.name}
                      type={field.type || "text"}
                      value={businessForm[field.name]}
                      onChange={handleBusinessChange}
                      placeholder={field.placeholder}
                      required={field.required || false}
                    />
                  </div>
                </div>
              );
            })}
          </div>

          <div className="jesta-settings-form-footer">
            <button
              type="button"
              className="jesta-settings-secondary-button"
              onClick={loadBusiness}
              disabled={savingBusiness}
            >
              <X size={17} />
              Reset
            </button>

            <button
              type="submit"
              className="jesta-settings-primary-button"
              disabled={savingBusiness || !navigator.onLine}
            >
              {savingBusiness ? (
                <>
                  <Loader2 size={17} className="jesta-settings-button-spinner" />
                  Saving...
                </>
              ) : (
                <>
                  <Save size={17} />
                  Save Changes
                </>
              )}
            </button>
          </div>
        </form>
      </div>
    );
  };

  /*
   * Payments / M-Pesa section
   */
  const renderPaymentsSection = () => {
    const merchantLabel =
      mpesaForm.merchant_type === "till"
        ? "Till Number"
        : "PayBill Number";

    return (
      <div className="jesta-settings-panel">
        <div className="jesta-settings-panel-header">
          <div className="jesta-settings-panel-heading">
            <div className="jesta-settings-panel-icon">
              <CreditCard size={20} />
            </div>
            <div>
              <h2>M-Pesa Payments</h2>
              <p>
                Configure the M-Pesa account that this business will use to receive customer payments.
              </p>
            </div>
          </div>

          <button
            type="button"
